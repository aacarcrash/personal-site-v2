# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# LaTeX build artifacts (source is *.tex; the served PDFs live in public/)
latex-src/*.aux
latex-src/*.log
latex-src/*.out
latex-src/*.pdf

# raw source screenshots / working assets (optimized copies live in public/images/)
/assets/

# Personal CV / career strategy docs — never commit
claude-web-career-conversations-and-plans/
.cv-extract/
job-search/
*_thumb.txt
.tmp-*.png

# admin panel (local-first)
.admin-log/

# local agent / tool scratch dirs
.claude/
.playwright-cli/

# web-verify harness artifacts
.verify/

